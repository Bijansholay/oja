# ==============================================================================
# ỌJÀ HYPERLOCAL FARM PRODUCE MARKETPLACE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# Appwrite Backend Configuration
# ------------------------------------------------------------------------------
# Public endpoint of your Appwrite server or Appwrite Cloud
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Public Project ID created in Appwrite console
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_appwrite_project_id

# Public Database & Storage Bucket identifiers (provisioned by scripts/setup-appwrite.mjs)
NEXT_PUBLIC_APPWRITE_DATABASE_ID=oja_marketplace_db
NEXT_PUBLIC_APPWRITE_BUCKET_ID=oja_produce_photos

# SERVER-ONLY: Secret Appwrite API Key (Must never be exposed to browser bundle!)
# Requires scopes: databases.read, databases.write, collections.read, collections.write,
# documents.read, documents.write, files.read, files.write, users.read, users.write
APPWRITE_API_KEY=your_secret_server_appwrite_api_key

# ------------------------------------------------------------------------------
# Payment Integration (Paystack)
# ------------------------------------------------------------------------------
# Public Paystack Key (used client-side for inline checkout popup if needed)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SERVER-ONLY: Secret Paystack Key (used for verifying webhooks and charge transactions)
# If not configured, the UI hides "Pay now" and provides only Pay on Delivery (POD)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# Application Base URL (for webhooks & OAuth redirects)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Ọjà

# ------------------------------------------------------------------------------
# Regional & Geolocation Configuration (Hyperlocal Marketplace Defaults)
# ------------------------------------------------------------------------------
# Default fallback center coordinates and region name when GPS is unavailable
NEXT_PUBLIC_DEFAULT_LAT=6.4281
NEXT_PUBLIC_DEFAULT_LNG=3.4219
NEXT_PUBLIC_DEFAULT_AREA_NAME="Victoria Island & Ikoyi, Lagos"
NEXT_PUBLIC_DEFAULT_RADIUS_KM=25

# ------------------------------------------------------------------------------
# Currency & Commerce Limits
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CURRENCY_CODE=NGN
NEXT_PUBLIC_CURRENCY_SYMBOL=₦
# Maximum allowable order value for first-time buyers choosing Pay on Delivery (fraud prevention)
ORDER_MAX_POD_LIMIT_NAIRA=35000
NEXT_PUBLIC_ORDER_MAX_POD_LIMIT_NAIRA=35000
NEXT_PUBLIC_FEED_PAGE_LIMIT=50

# ------------------------------------------------------------------------------
# Optional Demo Fallback Mode
# Set to 'true' to allow fully offline local demo mode without an active Appwrite instance
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DEMO_MODE=false
